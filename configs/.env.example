APP_ENV=dev
HTTP_ADDR=:8090
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

# MySQL (docker compose maps host port 3307)
MYSQL_DSN=otome:otome@tcp(127.0.0.1:3307)/otome?parseTime=true&charset=utf8mb4&loc=UTC&timeout=5s&readTimeout=10s&writeTimeout=10s

# Redis (docker compose maps host port 6380)
REDIS_ADDR=127.0.0.1:6380
REDIS_PASSWORD=
REDIS_DB=0

# Leave empty in dev to use an insecure built-in secret.
# In production set a random value of at least 32 bytes.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
